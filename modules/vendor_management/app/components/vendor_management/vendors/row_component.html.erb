<%= content_tag(:tr,
                id: row_css_id,
                class: row_css_class
    ) do %>
  <td class="select">
    <%= check_box_tag "vendor_ids[]", vendor.id, false, id: "vendor-select-#{vendor.id}", data: { "checkable-target": "checkbox" }, "aria-label": vendor.name %>
  </td>
  <% columns.each do |column| %>
    <td class="<%= column_css_class(column) %>">
      <%= column_value(column) %>
    </td>
  <% end %>
  <td class="buttons">
    <% button_links.each do |link| %>
      <%= link %>
    <% end %>
  </td>
<% end %>
