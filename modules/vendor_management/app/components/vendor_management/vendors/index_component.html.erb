<%=
component_wrapper do
  flex_layout do |flex|
    flex.with_row do
      render(Primer::OpenProject::SubHeader.new) do |subheader|
        subheader.with_action_button(
          scheme: :primary,
          leading_icon: :checklist,
          label: t("vendor_management.index.approval_chain_link"),
          tag: :a,
          href: helpers.vendor_management_approval_chain_path
        ) { t("vendor_management.index.approval_chain_link") }

        subheader.with_action_button(
          scheme: :primary,
          leading_icon: :file,
          label: t("vendor_management.index.po_template_link"),
          tag: :a,
          href: helpers.edit_vendor_management_po_template_path
        ) { t("vendor_management.index.po_template_link") }

        subheader.with_action_button(
          scheme: :primary,
          leading_icon: :pencil,
          label: t("vendor_management.index.po_template_designer_link"),
          tag: :a,
          href: helpers.designer_vendor_management_po_template_path
        ) { t("vendor_management.index.po_template_designer_link") }

        subheader.with_action_button(
          scheme: :primary,
          leading_icon: :download,
          label: t("vendor_management.index.export_link"),
          tag: :a,
          href: helpers.export_vendor_management_vendors_path
        ) { t("vendor_management.index.export_link") }

        if can_edit
          subheader.with_action_button(
            scheme: :primary,
            leading_icon: :upload,
            label: t("vendor_management.index.import_link"),
            tag: :a,
            href: helpers.import_new_vendor_management_vendors_path
          ) { t("vendor_management.index.import_link") }

          subheader.with_action_button(
            scheme: :primary,
            leading_icon: :plus,
            label: t("vendor_management.index.new_vendor"),
            tag: :a,
            href: helpers.url_for(action: :new),
            test_selector: "add-vendor-button"
          ) { t("vendor_management.index.new_vendor") }
        end
      end
    end

    flex.with_row(mt: 3) do
      helpers.render(partial: "vendor_management/vendor_filters", locals: { filters: filters })
    end

    flex.with_row do
      render(VendorManagement::Vendors::TableComponent.new(rows: vendors, can_edit: can_edit))
    end
  end
end
%>

