<% html_title t("vendor_management.vendor_form.title_edit") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("vendor_management.vendor_form.title_edit") }
    header.with_breadcrumbs(
      [
        { href: vendor_management_vendors_path, text: t("vendor_management.index.title") },
        t("vendor_management.vendor_form.title_edit")
      ]
    )
  end
%>

<%= primer_form_with(model: @vendor, scope: :vendor, url: vendor_management_vendor_path(@vendor), method: :patch) do |f| %>
  <%= render(VendorManagement::Vendors::VendorForm.new(f)) %>
<% end %>
