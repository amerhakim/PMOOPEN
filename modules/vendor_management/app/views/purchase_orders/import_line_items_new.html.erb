<% html_title t("vendor_management.line_item_import.title") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("vendor_management.line_item_import.title") }
    header.with_breadcrumbs(
      [
        { href: projects_vendor_management_purchase_orders_path(@project), text: t("vendor_management.purchase_orders.title") },
        { href: projects_edit_vendor_management_purchase_order_path(@project, @purchase_order), text: @purchase_order.po_number },
        t("vendor_management.line_item_import.title")
      ]
    )
  end
%>

<p class="op-form-hint">
  <%= t("vendor_management.line_item_import.hint") %>
  <%= link_to t("vendor_management.line_item_import.download_sample"), projects_import_sample_vendor_management_po_line_items_path(@project, @purchase_order) %>
</p>

<%= form_with url: projects_import_vendor_management_po_line_items_path(@project, @purchase_order), method: :post, multipart: true, local: true, data: { turbo: false } do |f| %>
  <div class="form--field">
    <label class="form--label" for="file"><%= t("vendor_management.import.file_label") %></label>
    <div class="form--field-container">
      <%= f.file_field :file, accept: ".xlsx" %>
    </div>
  </div>
  <div class="form--actions">
    <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t("vendor_management.import.submit") } %>
  </div>
<% end %>
