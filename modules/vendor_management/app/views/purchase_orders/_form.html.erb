<%# client_inline: false on the edit page, where the client / end-user fields are shown at the very bottom of the
    page (see _po_client) and posted with this same form through the HTML `form` attribute. %>
<% client_inline = local_assigns.fetch(:client_inline, true) %>
<% field = lambda do |label, id, input, wide: false, hint: nil, span: false|
     content_tag(:div, class: ["po-f", ("wide" if wide), ("span2" if span)]) do
       safe_join([content_tag(:label, label, for: id), input, (content_tag(:p, hint, class: "po-hint") if hint)].compact)
     end
   end %>
<%= render "purchase_orders/po_page_styles" if client_inline %>

<%= form_with model: @purchase_order, url: url, scope: "purchase_order", local: true, multipart: true, html: { id: "po_form", class: "po-page" }, data: { turbo: false } do |f| %>
  <% if @purchase_order.errors.any? %>
    <div class="flash error"><%= @purchase_order.errors.full_messages.join(", ") %></div>
  <% end %>

  <div class="po-grid">
    <% if @purchase_order.persisted? && @movable_projects.present? %>
      <%= field.call(t("vendor_management.po_form.project_label"), "purchase_order_project_id",
                     f.select(:project_id, options_for_select(@movable_projects.map { |p| [p.name, p.id] }, @purchase_order.project_id)),
                     wide: true, hint: t("vendor_management.po_form.project_hint")) %>
    <% end %>

    <%= field.call(t("vendor_management.po_form.po_number_label"), "purchase_order_po_number", f.text_field(:po_number)) %>
    <%= field.call(t("vendor_management.po_form.vendor_label"), "purchase_order_vendor_id", f.select(:vendor_id, @vendors.map { |v| [v.name, v.id] }, include_blank: true)) %>
    <%= field.call(t("vendor_management.po_form.quotation_ref_no_label"), "purchase_order_quotation_ref_no", f.text_field(:quotation_ref_no)) %>
    <%= field.call(t("vendor_management.po_form.issue_date_label"), "purchase_order_issue_date", f.date_field(:issue_date)) %>
    <%= field.call(t("vendor_management.po_form.expected_end_date_label"), "purchase_order_expected_end_date", f.date_field(:expected_end_date)) %>
    <%= field.call(t("vendor_management.po_form.currency_label"), "purchase_order_currency", f.select(:currency, VendorManagement::PurchaseOrder::CURRENCIES)) %>
    <%= field.call(t("vendor_management.po_form.status_label"), "purchase_order_status", f.select(:status, VendorManagement::PurchaseOrder::STATUSES.map { |s| [s.humanize, s] })) %>

    <%= field.call(t("vendor_management.po_form.discount_label"), "purchase_order_discount", f.number_field(:discount, step: "0.01", min: 0), hint: t("vendor_management.po_form.discount_hint")) %>
    <%= field.call(t("vendor_management.po_form.o_and_d_label"), "purchase_order_o_and_d", f.text_field(:o_and_d), hint: t("vendor_management.po_form.o_and_d_hint"), span: true) %>
    <% if @purchase_order.po_line_items.exists? %>
      <%= field.call(t("vendor_management.po_form.total_value_label"), "purchase_order_total_value",
                     content_tag(:div, number_to_currency(@purchase_order.total_value, unit: "#{@purchase_order.currency} ", format: "%u%n"), class: "po-static"),
                     hint: t("vendor_management.po_form.total_value_derived_hint"), span: true) %>
    <% else %>
      <%= field.call(t("vendor_management.po_form.total_value_label"), "purchase_order_total_value", f.number_field(:total_value, step: "0.01", min: 0),
                     hint: t("vendor_management.po_form.total_value_manual_hint"), span: true) %>
    <% end %>

    <%= field.call(t("vendor_management.po_form.order_description_label"), "purchase_order_order_description", f.text_area(:order_description, rows: 2), wide: true) %>
    <%= field.call(t("vendor_management.po_form.payment_terms_label"), "purchase_order_payment_terms", f.text_area(:payment_terms, rows: 3)) %>
    <%= field.call(t("vendor_management.po_form.special_note_label"), "purchase_order_special_note",
                   safe_join([f.text_area(:special_note, rows: 3),
                              content_tag(:label, safe_join([f.check_box(:is_non_cancellable), t("vendor_management.po_form.is_non_cancellable_label")]),
                                          for: "purchase_order_is_non_cancellable", class: "po-check")])) %>
    <%= field.call(t("vendor_management.po_form.incoterm_label"), "purchase_order_incoterm", f.text_area(:incoterm, rows: 3)) %>
    <%= field.call(t("vendor_management.po_form.delivery_contact_label"), "purchase_order_delivery_contact", f.text_area(:delivery_contact, rows: 3)) %>
    <%= field.call(t("vendor_management.po_form.delivery_address_label"), "purchase_order_delivery_address", f.text_field(:delivery_address), wide: true) %>

    <% file_part = capture do %>
      <% if @purchase_order.persisted? && @purchase_order.quotation_file_attached? %>
        <p style="margin: 0 0 8px;">
          <%= link_to "#{t('vendor_management.po_form.quotation_file_current')}: #{@purchase_order.quotation_file_filename}",
                      projects_vendor_management_purchase_order_quotation_file_path(@project, @purchase_order), target: "_blank" %>
          &mdash;
          <%= link_to t("vendor_management.po_form.quotation_file_remove"),
                      projects_destroy_vendor_management_purchase_order_quotation_file_path(@project, @purchase_order),
                      data: { turbo_method: :delete, turbo_confirm: t("text_are_you_sure") } %>
        </p>
      <% end %>
      <%= f.file_field :quotation_file %>
    <% end %>
    <%= field.call(t("vendor_management.po_form.quotation_file_label"), "purchase_order_quotation_file", file_part, wide: true) %>
  </div>

  <% if client_inline %>
    <h2 class="po-h"><%= t("vendor_management.po_page.client_section") %></h2>
    <div class="po-grid">
      <% %i[end_user_name end_user_contact_name end_user_contact_phone end_user_contact_email end_user_address].each do |attribute| %>
        <%= field.call(t("vendor_management.po_form.#{attribute}_label"), "purchase_order_#{attribute}", f.text_field(attribute), wide: attribute == :end_user_address) %>
      <% end %>
    </div>
  <% end %>

  <div class="po-formbar">
    <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t("vendor_management.po_form.submit") } %>
  </div>
<% end %>
