<% po = @purchase_order %>
<% total = po.total_value.to_f %>
<% paid_pct = total.positive? ? [po.total_paid.to_f / total * 100, 100].min : 0 %>
<% money = ->(amount) { number_to_currency(amount, unit: "", format: "%n") } %>

<div class="po-strip" aria-label="<%= t("vendor_management.po_page.summary") %>">
  <div>
    <div class="po-k"><%= t("vendor_management.po_page.po_total") %></div>
    <div class="po-v"><%= money.call(total) %><small><%= po.currency %></small></div>
    <% if po.discount.to_f.positive? %>
      <div style="font-size:12px; color:var(--po-muted); margin-top:4px;"><%= t("vendor_management.po_page.includes_discount", amount: money.call(po.discount), currency: po.currency) %></div>
    <% end %>
    <div class="po-bar blue" aria-hidden="true"><i style="width:100%"></i></div>
  </div>
  <div>
    <div class="po-k"><%= t("vendor_management.purchase_orders.total_paid") %></div>
    <div class="po-v"><%= money.call(po.total_paid) %><small><%= po.currency %></small></div>
    <div class="po-bar" aria-hidden="true"><i style="width:<%= paid_pct.round(1) %>%"></i></div>
  </div>
  <div>
    <div class="po-k"><%= t("vendor_management.purchase_orders.remaining_in_po") %></div>
    <div class="po-v"><%= money.call(po.remaining_in_po) %><small><%= po.currency %></small></div>
    <span class="po-pill <%= { 'paid' => 'good', 'partially_paid' => 'warn' }[po.payment_status] %>" style="margin-top:12px"><%= po.payment_status.humanize %></span>
  </div>
</div>
