<%= form_with model: @line_item, url: url, scope: "po_line_item", local: true, data: { turbo: false } do |f| %>
  <% if @line_item.errors.any? %>
    <div class="flash error"><%= @line_item.errors.full_messages.join(", ") %></div>
  <% end %>

  <div class="form--field">
    <label class="form--label" for="po_line_item_section_label"><%= t("vendor_management.line_item_form.section_label_label") %></label>
    <div class="form--field-container">
      <%= f.text_field :section_label %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_part_no"><%= t("vendor_management.line_item_form.part_no_label") %></label>
    <div class="form--field-container">
      <%= f.text_field :part_no %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_description"><%= t("vendor_management.line_item_form.description_label") %></label>
    <div class="form--field-container">
      <%= f.text_area :description, rows: 2 %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_item_type"><%= t("vendor_management.line_item_form.item_type_label") %></label>
    <div class="form--field-container">
      <%= f.select :item_type, VendorManagement::PoLineItem::ITEM_TYPES %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_quantity"><%= t("vendor_management.line_item_form.quantity_label") %></label>
    <div class="form--field-container">
      <%= f.text_field :quantity %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_unit_price"><%= t("vendor_management.line_item_form.unit_price_label") %></label>
    <div class="form--field-container">
      <%= f.text_field :unit_price %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_start_date"><%= t("vendor_management.line_item_form.start_date_label") %></label>
    <div class="form--field-container">
      <%= f.date_field :start_date %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label" for="po_line_item_end_date"><%= t("vendor_management.line_item_form.end_date_label") %></label>
    <div class="form--field-container">
      <%= f.date_field :end_date %>
    </div>
  </div>

  <div class="form--actions">
    <%= f.submit t("vendor_management.line_item_form.submit"), class: "button -highlight" %>
  </div>
<% end %>
