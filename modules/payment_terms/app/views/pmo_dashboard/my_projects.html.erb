<% html_title t("pmo_dashboard.my_projects_title") %>

<% if @has_any_scope_data %>
  <style>
    .pmo-tabs-wrap { display: inline-flex; gap: 2px; background: #eaeef2; padding: 4px; border-radius: 10px; }
    .pmo-tab-btn { border: none; background: none; padding: 8px 16px; font-size: 13px; font-weight: 600; color: #57606a; cursor: pointer; border-radius: 7px; transition: background 0.15s ease, color 0.15s ease; }
    .pmo-tab-btn[data-active="true"] { color: #0d1b2a; background: #fff; box-shadow: 0 1px 2px rgba(16,24,40,0.08); }
    .pmo-ov-cards { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; margin-bottom: 16px; }
    .pmo-ov-card { display: flex; align-items: flex-start; gap: 12px; padding: 16px 18px; border-radius: 12px; border: 1px solid #e8ecf3; cursor: pointer; min-width: 0; transition: box-shadow 0.15s ease, border-color 0.15s ease; }
    .pmo-ov-card:hover { box-shadow: 0 2px 8px rgba(16,24,40,0.08); }
    .pmo-ov-card[data-active="true"] { border-color: #0d1b2a; box-shadow: 0 0 0 2px rgba(13,27,42,0.12); }
    .pmo-ov-icon { flex-shrink: 0; margin-top: 2px; }
    .pmo-ov-card-label { font-size: 13px; font-weight: 600; color: #0d1b2a; }
    .pmo-ov-card-value { font-size: 30px; font-weight: 700; line-height: 1.15; color: #0d1b2a; margin: 2px 0 4px; }
    .pmo-ov-card-delta { font-size: 11px; font-weight: 600; white-space: nowrap; }
    .pmo-ov-panels { display: grid; grid-template-columns: 1.1fr 1.35fr 1fr; gap: 16px; margin-bottom: 24px; }
    .pmo-ov-panel { background: #fff; border: 1px solid #e8ecf3; border-radius: 12px; padding: 18px; min-width: 0; box-shadow: 0 1px 3px rgba(16,24,40,0.04); }
    .pmo-ov-title { font-size: 14px; font-weight: 700; color: #0d1b2a; margin-bottom: 12px; }
    .pmo-ov-donut-row { display: flex; align-items: center; gap: 18px; }
    .pmo-ov-legend { flex: 1 1 0; min-width: 0; max-width: 240px; }
    .pmo-ov-legend-row { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #374151; padding: 5px 0; }
    .pmo-ov-legend-label { flex: 1; }
    .pmo-ov-legend-num { font-weight: 700; color: #0d1b2a; min-width: 16px; text-align: right; }
    .pmo-ov-legend-pct { color: #6b7280; min-width: 34px; text-align: right; }
    .pmo-ov-legend-total { border-top: 1px solid #eef1f6; margin-top: 4px; padding-top: 8px; }
    .pmo-ov-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .pmo-ov-empty { font-size: 12px; color: #6b7280; margin: 24px 0; }
    .pmo-slide-loading { background: #fff; border: 1px dashed #d0d7de; border-radius: 12px; height: 100%; display: flex; align-items: center; justify-content: center; color: #6b7280; font-size: 13px; }
    .pmo-ov-wrap { container-type: inline-size; }
    .pmo-ov-chart { width: 100%; max-height: 230px; }
    @container (max-width: 1149px) {
      .pmo-ov-cards { grid-template-columns: repeat(3, 1fr); }
    }
    @container (max-width: 999px) {
      .pmo-ov-cards { grid-template-columns: repeat(3, 1fr); }
      .pmo-ov-panels { grid-template-columns: 1fr; }
    }
  </style>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h1 style="font-size: 24px; font-weight: 600; color: #0d1b2a; margin: 0;"><%= t("pmo_dashboard.my_projects_title") %></h1>
  </div>

  <% if @scopes.size > 1 %>
    <div class="pmo-tabs-wrap" style="margin-bottom: 20px;">
      <% @scopes.each_with_index do |scope, i| %>
        <button type="button" class="pmo-tab-btn" data-scope-tab="<%= scope[:key] %>" data-active="<%= i.zero? %>"><%= scope[:label] %></button>
      <% end %>
    </div>
  <% end %>

  <% @scopes.each_with_index do |scope, i| %>
    <div data-scope-panel="<%= scope[:key] %>"<%= " hidden".html_safe unless i.zero? %>>
      <%= render "scope", scope: scope %>
    </div>
  <% end %>

  <%= javascript_tag nonce: true do %>
    (function () {
      document.querySelectorAll("[data-scope-tab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var key = btn.dataset.scopeTab;
          document.querySelectorAll("[data-scope-tab]").forEach(function (b) { b.dataset.active = String(b === btn); });
          document.querySelectorAll("[data-scope-panel]").forEach(function (p) {
            p.hidden = p.dataset.scopePanel !== key;
            if (!p.hidden) p.dispatchEvent(new CustomEvent("pmo:shown"));
          });
        });
      });

      var cardCache = {};

      document.querySelectorAll("[data-scope-panel]").forEach(function (scopePanel) {
        var carousel = scopePanel.querySelector("[data-pmo-carousel]");
        if (!carousel) return;

        var perPage = 3;
        var allSlides = Array.prototype.slice.call(carousel.querySelectorAll(".pmo-slide"));
        var currentIndex = 0;
        var statusFilter = "active";

        var prevBtn = carousel.querySelector(".pmo-prev-btn");
        var nextBtn = carousel.querySelector(".pmo-next-btn");
        var indicator = scopePanel.querySelector(".pmo-page-indicator");
        var dots = scopePanel.querySelector(".pmo-dots");
        var noMatch = scopePanel.querySelector(".pmo-no-match");
        var filterCards = scopePanel.querySelectorAll("[data-status-filter]");

        function visibleSlides() {
          return allSlides.filter(function (slide) {
            if (statusFilter === "all") return true;
            if (statusFilter === "active") return slide.dataset.health !== "finished";
            return slide.dataset.health === statusFilter;
          });
        }

        // Cards are fetched three at a time, only for the page being shown.
        function loadCards(slides) {
          if (scopePanel.hidden) return;
          var pending = slides.filter(function (s) {
            if (s.dataset.loaded === "1" || s.dataset.loading === "1") return false;
            if (cardCache[s.dataset.projectId]) {
              s.innerHTML = cardCache[s.dataset.projectId];
              s.dataset.loaded = "1";
              return false;
            }
            return true;
          });
          if (!pending.length) return;
          pending.forEach(function (s) { s.dataset.loading = "1"; });
          var ids = pending.map(function (s) { return s.dataset.projectId; });
          fetch(carousel.dataset.cardsUrl + "?ids=" + ids.join(","), { credentials: "same-origin", headers: { "Accept": "application/json" } })
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(function (cards) {
              pending.forEach(function (s) {
                s.dataset.loading = "0";
                if (cards[s.dataset.projectId]) {
                  cardCache[s.dataset.projectId] = cards[s.dataset.projectId];
                  s.innerHTML = cards[s.dataset.projectId];
                  s.dataset.loaded = "1";
                }
              });
            })
            .catch(function () {
              pending.forEach(function (s) { s.dataset.loading = "0"; });
            });
        }

        function render() {
          var slides = visibleSlides();
          var total = slides.length;
          var totalPages = Math.max(1, Math.ceil(total / perPage));
          if (currentIndex >= total) currentIndex = 0;

          allSlides.forEach(function (slide) {
            var idx = slides.indexOf(slide);
            slide.style.display = (idx !== -1 && idx >= currentIndex && idx < currentIndex + perPage) ? "" : "none";
          });

          loadCards(slides.slice(currentIndex, currentIndex + perPage));

          carousel.style.display = total === 0 ? "none" : "flex";
          noMatch.style.display = total === 0 ? "" : "none";
          if (total === 0) { indicator.textContent = ""; dots.innerHTML = ""; return; }

          var last = Math.min(currentIndex + perPage, total);
          indicator.textContent = (currentIndex + 1) + " - " + last + " of " + total;

          var canLeft = currentIndex > 0;
          var canRight = currentIndex + perPage < total;
          prevBtn.style.cursor = canLeft ? "pointer" : "not-allowed";
          prevBtn.style.color = canLeft ? "#0d1b2a" : "#9ca3af";
          prevBtn.disabled = !canLeft;
          nextBtn.style.cursor = canRight ? "pointer" : "not-allowed";
          nextBtn.style.color = canRight ? "#0d1b2a" : "#9ca3af";
          nextBtn.disabled = !canRight;

          dots.innerHTML = "";
          for (var p = 0; p < totalPages; p++) {
            var dot = document.createElement("button");
            dot.type = "button";
            var active = currentIndex === p * perPage;
            dot.style.cssText = "width:" + (active ? 24 : 8) + "px;height:8px;border-radius:4px;background:" +
              (active ? "#0d1b2a" : "#d1d5db") + ";border:none;cursor:pointer;";
            (function (page) {
              dot.addEventListener("click", function () { currentIndex = page * perPage; render(); });
            })(p);
            dots.appendChild(dot);
          }
        }

        prevBtn.addEventListener("click", function () {
          if (currentIndex > 0) { currentIndex -= perPage; render(); }
        });
        nextBtn.addEventListener("click", function () {
          if (currentIndex + perPage < visibleSlides().length) { currentIndex += perPage; render(); }
        });

        filterCards.forEach(function (card) {
          card.addEventListener("click", function () {
            statusFilter = card.dataset.statusFilter;
            currentIndex = 0;
            filterCards.forEach(function (c) { c.dataset.active = String(c === card); });
            render();
          });
        });

        scopePanel.addEventListener("pmo:shown", render);
        render();
      });
    })();
  <% end %>
<% else %>
  <h2><%= t("pmo_dashboard.my_projects_title") %></h2>
  <p><%= t("pmo_dashboard.no_access") %></p>
<% end %>

