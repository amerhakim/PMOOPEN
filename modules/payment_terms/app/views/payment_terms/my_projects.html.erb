<% page_title = @archived_view ? t("payment_terms.archived.title") : t("payment_terms.my_projects.title") %>
<% html_title page_title %>

<h2><%= page_title %></h2>
<% all_payments = @payments_by_project.values.flatten %>
<% cancelled_count = all_payments.count(&:cancelled?) %>
<% by_currency = all_payments.reject(&:cancelled?).group_by(&:currency).transform_values(&:size).sort_by { |currency, _| [currency == "QAR" ? 0 : 1, currency] } %>
<p style="margin: 0 0 12px; color: #57606a; font-size: 13px;">
  <%= t("payment_terms.my_projects.projects_count", count: @payments_by_project.size) %> · <%= t("payment_terms.my_projects.payments_count", count: all_payments.size) %>
  <% if cancelled_count.positive? || by_currency.size > 1 %>
    (<%= (by_currency.map { |currency, n| "#{n} #{currency}" } + (cancelled_count.positive? ? [t("payment_terms.my_projects.cancelled_count", count: cancelled_count)] : [])).join(" · ") %>)
  <% end %>
</p>

<% if @archived_view %>
  <p style="color: #57606a; font-size: 13px; max-width: 760px;"><%= t("payment_terms.archived.note") %></p>
<% end %>
<p>
  <%= render(Primer::Beta::Button.new(scheme: :primary, tag: :a, href: export_my_payment_terms_path(archived: (@archived_view ? 1 : nil)))) do |btn| %>
    <% btn.with_leading_visual_icon(icon: :download) %>
    <%= t("payment_terms.my_projects.export_link") %>
  <% end %>
  <% unless @archived_view %>
    <%= link_to t("payment_terms.archived.title"), payment_terms_archived_path, style: "margin-left: 16px; font-size: 13px; font-weight: 600;" %>
  <% end %>
</p>

<%= form_with url: (@archived_view ? payment_terms_archived_path : my_payment_terms_path), method: :get, local: true do %>
  <div class="generic-table--container">
    <div class="generic-table--results-container">
      <table class="generic-table" style="table-layout: fixed; width: 100%; min-width: 1540px;">
        <colgroup>
          <col style="width: 40px;">
          <col style="width: 120px;">
          <col style="width: 70px;">
          <col style="width: 110px;">
          <col style="width: 230px;">
          <col style="width: 105px;">
          <col style="width: 55px;">
          <col style="width: 100px;">
          <col style="width: 78px;">
          <col style="width: 100px;">
          <col style="width: 100px;">
          <col style="width: 105px;">
          <col style="width: 100px;">
          <col>
          <col style="width: 110px;">
        </colgroup>
        <thead>
          <tr>
            <% %w[sn project o_and_d project_manager payment value invoiced expected_invoice_date collected expected_collection_date actual_collection_date invoice_number invoice_date comments account_manager].each do |column| %>
              <th style="white-space: normal; vertical-align: middle; text-align: center; line-height: 1.25; padding: 0;">
                <div class="generic-table--sort-header-outer" style="display: flex; align-items: center; justify-content: center; height: auto; min-height: 40px; line-height: 1.25; padding: 4px 3px; white-space: normal; text-align: center;">
                  <div class="generic-table--sort-header" style="width: auto; min-width: 0; overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.25; text-align: center; clear: none;">
                    <span style="display: block; white-space: normal; text-align: center; font-size: 11px;"><%= t("payment_terms.columns.#{column}") %></span>
                  </div>
                </div>
              </th>
            <% end %>
          </tr>
          <tr class="payment-terms--filter-row">
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :small, "aria-label": t("payment_terms.filters.apply"))) do %>
                <%= render(Primer::Beta::Octicon.new(icon: :filter, size: :small)) %>
              <% end %>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <select name="q[project]" class="payment-terms--filter-select" style="width:100%; height:28px; font-size:12px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
                <%= options_for_select([[t("payment_terms.filters.all"), ""]] + @project_options.map { |name| [name, name] }, @filters[:project]) %>
              </select>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <%= render(Primer::Alpha::TextField.new(name: "q[o_and_d]", label: t("payment_terms.columns.o_and_d"), visually_hide_label: true, value: @filters[:o_and_d], placeholder: t("payment_terms.columns.o_and_d"), full_width: true, size: :small)) %>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <select name="q[project_manager]" class="payment-terms--filter-select" style="width:100%; height:28px; font-size:12px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
                <%= options_for_select([[t("payment_terms.filters.all"), ""]] + @project_manager_options.map { |name| [name, name] }, @filters[:project_manager]) %>
              </select>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <%= render(Primer::Alpha::TextField.new(name: "q[description]", label: t("payment_terms.columns.payment"), visually_hide_label: true, value: @filters[:description], placeholder: t("payment_terms.filters.search_placeholder"), full_width: true, size: :small)) %>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <%= render(Primer::Alpha::TextField.new(name: "q[value]", label: t("payment_terms.columns.value"), visually_hide_label: true, value: @filters[:value], placeholder: "0.00", full_width: true, size: :small)) %>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <select name="q[invoiced]" class="payment-terms--filter-select" style="width:100%; height:28px; font-size:12px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
                <%= options_for_select([[t("payment_terms.filters.all"), ""], [t(:general_text_yes), "true"], [t(:general_text_no), "false"]], @filters[:invoiced]) %>
              </select>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <input type="month" name="q[expected_invoice_month]" value="<%= @filters[:expected_invoice_month] %>" class="payment-terms--filter-input" style="width:100%; height:28px; font-size:11px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <select name="q[collected]" class="payment-terms--filter-select" style="width:100%; height:28px; font-size:12px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
                <%= options_for_select([[t("payment_terms.filters.all"), ""], [t(:general_text_yes), "true"], [t(:general_text_no), "false"]], @filters[:collected]) %>
              </select>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <input type="month" name="q[expected_collection_month]" value="<%= @filters[:expected_collection_month] %>" class="payment-terms--filter-input" style="width:100%; height:28px; font-size:11px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <input type="month" name="q[actual_collection_month]" value="<%= @filters[:actual_collection_month] %>" class="payment-terms--filter-input" style="width:100%; height:28px; font-size:11px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <%= render(Primer::Alpha::TextField.new(name: "q[invoice_number]", label: t("payment_terms.columns.invoice_number"), visually_hide_label: true, value: @filters[:invoice_number], placeholder: t("payment_terms.filters.search_placeholder"), full_width: true, size: :small)) %>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <input type="month" name="q[invoice_month]" value="<%= @filters[:invoice_month] %>" class="payment-terms--filter-input" style="width:100%; height:28px; font-size:11px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <%= render(Primer::Alpha::TextField.new(name: "q[comments]", label: t("payment_terms.columns.comments"), visually_hide_label: true, value: @filters[:comments], placeholder: t("payment_terms.filters.search_placeholder"), full_width: true, size: :small)) %>
            </td>
            <td class="payment-terms--filter-cell" style="background-color: var(--bgColor-muted, #f6f8fa); border-bottom: 1px solid var(--borderColor-default, #d0d7de); padding: 4px 6px; vertical-align: middle;">
              <select name="q[account_manager]" class="payment-terms--filter-select" style="width:100%; height:28px; font-size:12px; border:1px solid var(--borderColor-default, #d0d7de); border-radius:6px; padding:0 6px;">
                <%= options_for_select([[t("payment_terms.filters.all"), ""]] + @account_manager_options.map { |name| [name, name] }, @filters[:account_manager]) %>
              </select>
            </td>
          </tr>
        </thead>
        <tbody>
          <% if @payments_by_project.empty? %>
            <tr class="generic-table--empty-row"><td colspan="15"><%= t("payment_terms.my_projects.no_payments") %></td></tr>
          <% else %>
            <% @payments_by_project.each_with_index do |(project, payments), project_index| %>
              <% payments.each_with_index do |payment, row_index| %>
                <% row_color = payment_row_color_class(payment) %>
                <tr>
                  <% if row_index.zero? %>
                    <td rowspan="<%= payments.size %>"><%= project_index + 1 %></td>
                    <td rowspan="<%= payments.size %>" style="white-space: normal; overflow-wrap: anywhere;"><%= project.active? || User.current.admin? ? link_to(project.name, projects_payment_terms_path(project)) : project.name %></td>
                    <td rowspan="<%= payments.size %>"><%= @o_and_ds[project.id] %></td>
                    <td rowspan="<%= payments.size %>">
                      <% Array(@project_managers[project.id]).each do |name| %>
                        <div><%= render(Primer::Beta::Text.new(font_size: :small, color: :subtle)) { name } %></div>
                      <% end %>
                    </td>
                  <% end %>
                  <td class="<%= row_color %>">
                    <% if payment.cancelled? %><s><%= payment.description %></s> <span class="payment-terms-cancelled-badge"><%= t("payment_terms.index.cancelled_badge") %></span><% else %><%= payment.description %><% end %>
                  </td>
                  <td class="<%= row_color %>"><%= payment_terms_amount(payment.value, payment.currency) if payment.value %></td>
                  <td class="<%= row_color %>"><%= payment.invoiced? ? t(:general_text_yes) : t(:general_text_no) %></td>
                  <td class="<%= row_color %>"><%= format_date(payment.expected_invoice_date) %></td>
                  <td class="<%= row_color %>"><%= payment.collected? ? t(:general_text_yes) : t(:general_text_no) %></td>
                  <td class="<%= row_color %>"><%= format_date(payment.expected_collection_date) %></td>
                  <td class="<%= row_color %>"><%= format_date(payment.actual_collection_date) %></td>
                  <td class="<%= row_color %>"><%= payment.invoice_number %></td>
                  <td class="<%= row_color %>"><%= format_date(payment.invoice_date) %></td>
                  <td class="<%= row_color %>"><%= payment.comments %></td>
                  <% if row_index.zero? %>
                    <td rowspan="<%= payments.size %>">
                      <%= render(Primer::Beta::Text.new(font_size: :small, color: :subtle)) { @account_managers[project.id] } %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>


