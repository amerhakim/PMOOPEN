<%= form_with url: projects_payment_terms_path(contract_line.project), method: :get, local: true do %>
  <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; margin-bottom:8px;">
    <div>
      <label class="form--label" for="payment_q_<%= contract_line.id %>_description"><%= t("payment_terms.filters.description") %></label><br>
      <%= text_field_tag "payment_q[#{contract_line.id}][description]", filters[:description], id: "payment_q_#{contract_line.id}_description", class: "form--text-field", style: "width:150px;" %>
    </div>
    <div>
      <label class="form--label" for="payment_q_<%= contract_line.id %>_milestone"><%= t("payment_terms.filters.milestone") %></label><br>
      <%= text_field_tag "payment_q[#{contract_line.id}][milestone]", filters[:milestone], id: "payment_q_#{contract_line.id}_milestone", class: "form--text-field", style: "width:130px;" %>
    </div>
    <div>
      <label class="form--label" for="payment_q_<%= contract_line.id %>_invoiced"><%= t("payment_terms.filters.invoiced") %></label><br>
      <%= select_tag "payment_q[#{contract_line.id}][invoiced]",
                      options_for_select([[t("payment_terms.filters.all"), ""], [t(:general_text_yes), "true"], [t(:general_text_no), "false"]], filters[:invoiced]),
                      id: "payment_q_#{contract_line.id}_invoiced", class: "form--select", style: "width:90px;" %>
    </div>
    <div>
      <label class="form--label" for="payment_q_<%= contract_line.id %>_collected"><%= t("payment_terms.filters.collected") %></label><br>
      <%= select_tag "payment_q[#{contract_line.id}][collected]",
                      options_for_select([[t("payment_terms.filters.all"), ""], [t(:general_text_yes), "true"], [t(:general_text_no), "false"]], filters[:collected]),
                      id: "payment_q_#{contract_line.id}_collected", class: "form--select", style: "width:90px;" %>
    </div>
    <div>
      <label class="form--label" for="payment_q_<%= contract_line.id %>_invoice_number"><%= t("payment_terms.filters.invoice_number") %></label><br>
      <%= text_field_tag "payment_q[#{contract_line.id}][invoice_number]", filters[:invoice_number], id: "payment_q_#{contract_line.id}_invoice_number", class: "form--text-field", style: "width:120px;" %>
    </div>
    <div style="display:flex; gap:8px;">
      <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :small)) { t("payment_terms.filters.apply") } %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, size: :small, tag: :a, href: projects_payment_terms_path(contract_line.project))) { t("payment_terms.filters.clear") } %>
    </div>
  </div>
<% end %>
